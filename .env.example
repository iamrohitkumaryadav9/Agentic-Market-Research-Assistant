# Market Research Agent - Environment Configuration
# Copy this file to .env and fill in your values.  .env is git-ignored.

# === LLM Provider ===
# Choose one: "anthropic", "openai", "gemini", or "ollama" (local, no API key)
LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama (no hosted LLM API key required): `ollama pull qwen3:4b`
# Inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Local CPU models are slow: classify at most this many articles per run
OLLAMA_MAX_SENTIMENT_ARTICLES=1
# Max output tokens per local LLM call
OLLAMA_NUM_PREDICT=1024

# LLM temperature (lower = more deterministic)
LLM_TEMPERATURE=0.2

# === Data Sources ===
# Massive.com (formerly Polygon.io) - ticker-scoped news.
# Falls back to Google News RSS if missing or rate-limited.
# Get a key at https://massive.com/dashboard
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# === Graph ===
# Max critique->revise cycles before the draft goes to the human anyway
CRITIQUE_MAX_RETRIES=2
RUN_TRACES_DIR=run_traces

# === Observability ===
# LangSmith tracing (optional)
# Get a key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=market-research-agent
LANGSMITH_TRACING_V2=false

# === Checkpointer ===
# Options: "memory" (default, dev only), "sqlite", "postgres"
CHECKPOINTER_BACKEND=memory
# SQLITE_DB_PATH=./checkpoints.db
# POSTGRES_CONN_STRING=postgresql://user:pass@host:5432/dbname
